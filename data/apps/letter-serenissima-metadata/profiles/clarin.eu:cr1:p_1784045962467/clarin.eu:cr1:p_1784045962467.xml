<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<ComponentSpec isProfile="true" CMDVersion="1.2" CMDOriginalVersion="1.2" xsi:noNamespaceSchemaLocation="https://infra.clarin.eu/CMDI/1.x/xsd/cmd-component.xsd" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
	<Header>
		<ID>clarin.eu:cr1:p_1784045962467</ID>
		<Name>LetterSimpleFormat</Name>
		<Description>A test profile to see if we can simplify the template for letter metadata with schema.org.</Description>
		<Status>development</Status>
	</Header>
	<Component name="LetterSimpleFormat" CardinalityMin="1" CardinalityMax="1">
		<Documentation>Test</Documentation>
		<Element name="project" CardinalityMin="1" CardinalityMax="unbounded" cue:DisplayPriority="1" xmlns:cue="http://www.clarin.eu/cmd/cues/1">
			<ValueScheme>
				<Vocabulary>
					<enumeration>
						<item>Suriano</item>
						<item>Contarini</item>
					</enumeration>
				</Vocabulary>
			</ValueScheme>
		</Element>
		<Component name="Identifiers" ComponentRef="clarin.eu:cr1:c_1761816151559" ConceptLink="http://www.cidoc-crm.org/cidoc-crm/E42_Identifier" CardinalityMin="1" CardinalityMax="1">
			<Documentation>Internal note: for Letters (profile v2), the URI should be mapped to: https://lod.academy/cer/vocab/ontology#21_Identifier. CIDOC path: -&gt;P1-&gt;E42[1_1]-&gt;P190-&gt;rdf:Literal. </Documentation>
			<Element name="identifierType" ConceptLink="http://purl.org/dc/terms/type" CardinalityMin="1" CardinalityMax="1" cue:DisplayPriority="1" xmlns:cue="http://www.clarin.eu/cmd/cues/1">
				<Documentation>The type/scheme of identifier (e.g., "Wikidata QID", "VIAF", "project local"</Documentation>
				<ValueScheme>
					<Vocabulary>
						<enumeration>
							<!--							<item ConceptLink="" AppInfo="">CERL</item>-->
							<item ConceptLink="" AppInfo="">EMLO</item>
							<item ConceptLink="http://id.loc.gov/ontologies/bibframe/Local" AppInfo="">LocalIdentifier</item>
							<!--							<item ConceptLink="" AppInfo="">NODEGOAT</item>-->
							<!--							<item ConceptLink="https://www.openstreetmap.org/relation" AppInfo="">OpenStreetMaps</item>-->
							<item ConceptLink="" AppInfo="">Shelfmark</item>
							<!--							<item ConceptLink="https://viaf.org" AppInfo="Virtual International Authority File">VIAF</item>-->
							<!--							<item ConceptLink="https://www.wikidata.org" AppInfo="">Wikidata</item>-->
							<item ConceptLink="" AppInfo="">Other</item>
						</enumeration>
					</Vocabulary>
				</ValueScheme>
			</Element>
			<Element name="identifierValue" ConceptLink="http://purl.org/dc/terms/identifier" ValueScheme="string" CardinalityMin="1" CardinalityMax="1" cue:DisplayPriority="2" xmlns:cue="http://www.clarin.eu/cmd/cues/1">
				<Documentation>Add the identifier's label (e.g., the shelfmark, or the identifier number in another scheme). If you chose "Other" in the Identifier type, enter here in parenthesis where the identifier comes from, for example: N011111 (Nodegoat).</Documentation>
			</Element>
			<Element name="identifierUri" ConceptLink="https://schema.org/sameAs" ValueScheme="anyURI" CardinalityMin="0" CardinalityMax="1" cue:DisplayPriority="3" xmlns:cue="http://www.clarin.eu/cmd/cues/1">
				<Documentation>Persistent identifier (optional): If the object has a permanent identifier (e.g., a URN, DOI, or handle), enter the full IRI here (e.g., https://resolver.staatsbibliothek-berlin.de/SBB00019E8400000003). It does not need to be resolvable. If it is OpenStreetMaps: Enter the URI from OpenStreetMap API. You can search directly in OpenStreetMaps and paste the URI here. The URI has to have this format, for example: https://www.openstreetmap.org/relation/214885 (note the type in the middle: relation, node, way)</Documentation>
			</Element>
		</Component>
		<Element name="sender" ValueScheme="string" CardinalityMin="1" CardinalityMax="unbounded" cue:DisplayPriority="2" cue:class="skosType" xmlns:cue="http://www.clarin.eu/cmd/cues/1"/>
		<Element name="dateSent" ConceptLink="https://schema.org/dateSent" ValueScheme="string" CardinalityMin="1" CardinalityMax="1" cue:DisplayPriority="4" xmlns:cue="http://www.clarin.eu/cmd/cues/1"/>
		<Element name="senderLocation" ValueScheme="string" CardinalityMin="1" CardinalityMax="1" cue:DisplayPriority="3" cue:class="skosType" xmlns:cue="http://www.clarin.eu/cmd/cues/1"/>
		<Element name="recipient" ValueScheme="string" CardinalityMin="1" CardinalityMax="unbounded" cue:DisplayPriority="4" cue:class="skosType" xmlns:cue="http://www.clarin.eu/cmd/cues/1"/>
		<Element name="recipientLocation" ValueScheme="string" CardinalityMin="1" CardinalityMax="1" cue:DisplayPriority="5" cue:class="skosType" xmlns:cue="http://www.clarin.eu/cmd/cues/1"/>
		<Element name="summary" ValueScheme="string" CardinalityMin="1" CardinalityMax="1" cue:DisplayPriority="6" xmlns:cue="http://www.clarin.eu/cmd/cues/1"/>
		<Component name="MentionedPerson" CardinalityMin="0" CardinalityMax="unbounded">
			<Element name="personLink" ValueScheme="string" CardinalityMin="1" CardinalityMax="1" cue:DisplayPriority="1" cue:class="skosType" xmlns:cue="http://www.clarin.eu/cmd/cues/1"/>
			<Element name="note" ValueScheme="string" CardinalityMin="0" CardinalityMax="1"/>
		</Component>
		<Component name="SeeAlso" ComponentRef="clarin.eu:cr1:c_1772521921738" ConceptLink="" CardinalityMin="1" CardinalityMax="1">
			<Element name="url" ConceptLink="http://www.w3.org/2000/01/rdf-schema#seeAlso" ValueScheme="string" CardinalityMin="1" CardinalityMax="1" cue:DisplayPriority="1" xmlns:cue="http://www.clarin.eu/cmd/cues/1"/>
			<Element name="label" ConceptLink="http://www.w3.org/2000/01/rdf-schema#label" ValueScheme="string" CardinalityMin="0" CardinalityMax="1" cue:DisplayPriority="2" xmlns:cue="http://www.clarin.eu/cmd/cues/1"/>
			<Element name="providerSource" ConceptLink="http://purl.org/dc/terms/publisher" ValueScheme="string" CardinalityMin="0" CardinalityMax="1" cue:DisplayPriority="3" xmlns:cue="http://www.clarin.eu/cmd/cues/1">
				<Documentation>the name of the repository or project (e.g., "correspSearch", "Kalliope", "Deutsches Textarchiv")</Documentation>
			</Element>
		</Component>
		<Component name="Note" ComponentRef="clarin.eu:cr1:c_1778593302212" ConceptLink="" CardinalityMin="0" CardinalityMax="1">
			<Documentation>Any</Documentation>
			<Element name="noteType" ConceptLink="http://purl.org/dc/terms/type" CardinalityMin="1" CardinalityMax="1" cue:DisplayPriority="1" xmlns:cue="http://www.clarin.eu/cmd/cues/1">
				<Documentation>Add any specific types of notes to the controlled vocabulary.</Documentation>
				<ValueScheme>
					<Vocabulary>
						<enumeration>
							<item>generalNote</item>
							<item>attachments</item>
							<item>order-of-letter</item>
						</enumeration>
					</Vocabulary>
				</ValueScheme>
			</Element>
			<Element name="noteContent" ValueScheme="string" CardinalityMin="1" CardinalityMax="1" cue:DisplayPriority="2" xmlns:cue="http://www.clarin.eu/cmd/cues/1"/>
		</Component>
	</Component>
</ComponentSpec>
